# DS2API runtime
# Runtime listen port inside the app/container
PORT=5001
# Host port for docker-compose.dev.yml only (dev).
# Production docker-compose.yml uses host network mode, so the listen port
# comes from PORT above and this variable is ignored.
DS2API_HOST_PORT=6011
LOG_LEVEL=INFO

# Admin authentication
# 默认留空会自动随机生成 admin 密码，并在启动日志 banner 中醒目显示（仅显示一次）；取消注释可自行设定。
# 注意：env-backed / Vercel 环境下随机密码不落盘、重启会变，这类环境应显式设置 DS2API_ADMIN_KEY。
# DS2API_ADMIN_KEY=change-me

# Config loading (choose one)
# 1) file-based config
DS2API_CONFIG_PATH=/app/config.json
# 2) inline JSON or Base64 JSON
# DS2API_CONFIG_JSON=
# 3) legacy compatibility alias
# CONFIG_JSON=

# Optional: static admin assets path
# DS2API_STATIC_ADMIN_DIR=/app/static/admin

# Optional: Mihomo proxy bridge (one-account-one-IP)
# Explicit path to the mihomo/mihomo.exe binary (auto-detected when unset)
# MIHOMO_PATH=
# Working directory for generated runtime.yaml / mihomo.log / cache
# DS2API_MIHOMO_DIR=./data/mihomo
# Subscriptions and port map persistence file (defaults to same directory as config.json; in Docker Compose, recommended /app/data/mihomo_subscriptions.json)
# DS2API_MIHOMO_SUBSCRIPTIONS_PATH=/app/data/mihomo_subscriptions.json
